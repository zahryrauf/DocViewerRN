{
  "expo": {
    "name": "DocViewer",
    "slug": "docviewer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.zahry.docviewer"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": [
                "**/lib/x86/libc++_shared.so",
                "**/lib/x86_64/libc++_shared.so",
                "**/lib/arm64-v8a/libc++_shared.so",
                "**/lib/armeabi-v7a/libc++_shared.so"
              ]
            }
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2103271b-931d-4470-a643-31fca90dc52b"
      }
    }
  }
}
